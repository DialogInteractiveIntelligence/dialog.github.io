---
/** Shared news card with a consistent photo header and content panel. */
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import { href } from '../lib/url';
import { formatDate } from '../lib/format';
interface Props { post: CollectionEntry<'news'>; compact?: boolean; }
const { post, compact = false } = Astro.props;
const d = post.data;
const pageHref = href(`/news/${post.id}/`);
const photos = d.images.length ? d.images : d.image ? [{ src: d.image, alt: d.imageAlt ?? '' }] : [];
const rendered = !compact && !d.standalone ? await render(post) : undefined;
const Content = rendered?.Content;
---

<article id={post.id} class:list={['news-item', { 'news-item--compact': compact }]} aria-labelledby={`title-${post.id}`}>
  {!compact && (
    <div class:list={['news-item__header', { 'news-item__header--pair': photos.length === 2 }]}>
      {photos.length ? photos.map((photo) => (
        <Image src={photo.src} widths={[480, 800, 1200]} sizes="(min-width: 76rem) 46rem, 90vw" alt={photo.alt} />
      )) : <span class="news-item__placeholder" aria-hidden="true">DIALOG<span>News &amp; updates</span></span>}
    </div>
  )}
  <div class="news-item__body">
    <div class="news-item__meta">
      {d.tags.length > 0 && <span class="tag">{d.tags[0]}</span>}
      <time class="small muted" datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time>
    </div>
    <h3 id={`title-${post.id}`} class="news-item__title">
      {d.standalone ? <a href={pageHref}>{d.title}</a> : d.title}
    </h3>
    {Content ? <div class="news-item__text muted"><Content /></div> : <p class="news-item__text muted">{d.summary}</p>}
    {!compact && d.standalone && <a class="arrow-link news-item__more" href={pageHref} aria-label={`Read more: ${d.title}`}>Read more</a>}
  </div>
</article>

<style>
  .news-item {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--paper);
  }
  .news-item__header {
    display: grid;
    aspect-ratio: 5 / 2;
    overflow: hidden;
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
  }
  .news-item__header--pair { grid-template-columns: 2fr 1fr; gap: 3px; }
  .news-item__header :global(img) {
    width: 100%; height: 100%; min-height: 0; object-fit: cover;
  }
  .news-item__placeholder {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-s);
    color: var(--accent);
    font-size: var(--step-3);
    letter-spacing: 0.06em;
  }
  .news-item__placeholder span { font-size: var(--step--1); letter-spacing: 0; }
  .news-item__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-s);
    min-height: 15rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .news-item__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-s);
    font-variant-numeric: tabular-nums;
  }
  .news-item__meta .tag {
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius);
  }
  .news-item__title { font-size: var(--step-2); }
  .news-item__text { max-width: 80ch; line-height: 1.65; text-wrap: pretty; }
  .news-item__text :global(p + p) { margin-top: var(--space-s); }
  .news-item__more { margin-top: auto; padding-top: var(--space-s); }
  .news-item--compact { border: 0; border-radius: 0; }
  .news-item--compact + .news-item--compact { border-top: 1px solid var(--line); }
  .news-item--compact .news-item__body { min-height: 0; padding: var(--space-m) 0; }
  .news-item--compact .news-item__title { font-size: var(--step-1); }
  .news-item--compact .news-item__text { font-size: var(--step--1); }
</style>
