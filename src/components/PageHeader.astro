---
/** Large title block at the top of index pages. */
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<header class="page-header container">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {lede && <p class="lede measure">{lede}</p>}
  <slot />
</header>

<style>
  .page-header {
    padding-block: var(--space-xl) var(--space-l);
    display: grid;
    gap: var(--space-s);
  }
  h1 {
    font-size: var(--step-4);
  }
  .lede {
    margin-top: var(--space-xs);
  }
</style>
