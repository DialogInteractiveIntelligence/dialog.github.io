---
/** One publication with its official link, citation copy action and full date. */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Authors from './Authors.astro';
import CopyButton from './CopyButton.astro';
import { href } from '../lib/url';
import { publicationDate } from '../lib/format';

interface Props {
  pub: CollectionEntry<'publications'>;
  people: CollectionEntry<'people'>[];
  highlight?: string;
  loading?: 'lazy' | 'eager';
  /** A short text-only entry for a person's publication list. */
  compact?: boolean;
}
const { pub, people, highlight, loading = 'lazy', compact = false } = Astro.props;
const d = pub.data;
const date = publicationDate(d);
const doiHref = d.doi ? `https://doi.org/${d.doi}` : undefined;
const paperHref = doiHref ?? d.url ?? href(`/publications/${pub.id}/`);
---

<article class:list={['pub', { 'pub--compact': compact, 'pub--illustrated': d.image && !compact }]} id={pub.id}>
  {d.image && !compact && (
    <a class="thumb pub__thumb" href={paperHref} aria-hidden="true" tabindex="-1">
        <Image src={d.image} width={320} height={240} widths={[320, 640]} sizes="(min-width: 40em) 160px, 25vw" alt="" loading={loading} />
    </a>
  )}
  <div class="pub__body">
    <h3 class="pub__title"><a href={paperHref}>{d.title}</a></h3>
    {!compact && <p class="pub__authors"><Authors authors={d.authors} people={people} highlight={highlight} /></p>}
    <p class="pub__venue small muted">
      {d.venue && <cite>{d.venue}</cite>}
      {(d.type === 'misc' || d.type === 'unpublished') && <span class="pub__status"> · Preprint</span>}
      {!d.venue && <span>{d.typeLabel}</span>}
    </p>
    <div class="pub__links">
      {doiHref && <a class="pub__doi" href={doiHref}>DOI</a>}
      {!compact && <CopyButton text={d.bibtex} />}
    </div>
    <time class="pub__date small muted" datetime={date.iso}>{date.label}</time>
  </div>
</article>

<style>
  .pub {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m) var(--space-l);
    padding-block: var(--space-m);
  }
  .pub--illustrated {
    grid-template-columns: 8rem minmax(0, 1fr);
  }
  .pub__date {
    display: block;
    margin-top: 0.35rem;
    font-variant-numeric: tabular-nums;
  }
  .pub + .pub {
    border-top: 1px solid var(--line);
  }
  .pub__thumb {
    aspect-ratio: 4 / 3;
    align-self: start;
    display: grid;
    place-items: center;
  }
  .pub__body {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }
  .pub__title {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.35;
  }
  .pub__title a:hover {
    color: var(--accent);
  }
  .pub__authors {
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.5;
  }
  cite {
    font-style: italic;
  }
  .pub__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.4rem;
    min-width: 0;
  }
  .pub__doi {
    color: light-dark(#185abd, #8fc3ff);
    font-size: var(--step--1);
    font-weight: 700;
  }
  .pub__doi:hover {
    text-decoration: underline;
  }
  @media (max-width: 40em) {
    .pub {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }
    .pub__thumb {
      width: 50%;
      max-width: 12rem;
    }
  }
</style>
