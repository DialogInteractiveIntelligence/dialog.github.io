---
/** Accessible "Copy BibTeX" button: copies `text` to the clipboard on click. */
interface Props {
  text: string;
  label?: string;
}
const { text, label = 'Copy BibTeX' } = Astro.props;
---

<button type="button" class="pill copy-button" data-copy-button data-copy-text={text}>
  <span data-copy-button-label>{label}</span>
</button>
<span class="visually-hidden" data-copy-button-status role="status" aria-live="polite"></span>

<style>
  .copy-button {
    font: inherit;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  function initCopyButtons(root: ParentNode) {
    root.querySelectorAll<HTMLButtonElement>('[data-copy-button]').forEach((button) => {
      if (button.dataset.copyButtonBound) return;
      button.dataset.copyButtonBound = 'true';

      const label = button.querySelector<HTMLElement>('[data-copy-button-label]');
      const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-button-status]');
      const originalLabel = label?.textContent ?? 'Copy BibTeX';

      button.addEventListener('click', async () => {
        const text = button.dataset.copyText ?? '';
        try {
          await navigator.clipboard.writeText(text);
          if (label) label.textContent = 'Copied!';
          if (status) status.textContent = 'BibTeX copied to clipboard.';
        } catch {
          if (label) label.textContent = 'Copy failed';
          if (status) status.textContent = 'Could not copy BibTeX to clipboard.';
        }
        setTimeout(() => {
          if (label) label.textContent = originalLabel;
        }, 2000);
      });
    });
  }

  initCopyButtons(document);
  document.addEventListener('astro:page-load', () => initCopyButtons(document));
</script>
