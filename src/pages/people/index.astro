---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PersonCard from '../../components/PersonCard.astro';
import { site } from '../../site.config';
import { ROLE_ORDER, ROLE_LABELS, sortPeople } from '../../lib/people';
import { breadcrumbJsonLd, collectionPageJsonLd } from '../../lib/seo';

const people = sortPeople(await getCollection('people'));
const groups = ROLE_ORDER.map((role) => ({
  role,
  label: ROLE_LABELS[role],
  members: people.filter((p) => p.data.role === role),
})).filter((g) => g.members.length > 0);

const description = `The members of ${site.name}: faculty, postdoctoral researchers, PhD candidates and students.`;
const jsonLd = [
  breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'People', path: '/people/' }], Astro.site),
  collectionPageJsonLd('People', description, '/people/', Astro.site, people.map((p) => ({ name: p.data.name, path: `/people/${p.id}/` }))),
];
---

<Base title="People" description={description} jsonLd={jsonLd}>
  <PageHeader eyebrow="Who we are" title="People" lede={description} />

  <div class="container">
    {
      groups.map(({ role, label, members }) => (
        <section class="section role-group" aria-labelledby={`role-${role}`}>
          <h2 id={`role-${role}`} class="role-group__title">{label}</h2>
          <div class="grid grid--people">
            {members.map((person) => (
              <PersonCard person={person} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .role-group {
    padding-block: var(--space-l);
  }
  .role-group + .role-group {
    border-top: 1px solid var(--line);
  }
  .role-group__title {
    font-size: var(--step-2);
    margin-bottom: var(--space-l);
  }
</style>
