---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsItem from '../../components/NewsItem.astro';
import { breadcrumbJsonLd, collectionPageJsonLd } from '../../lib/seo';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const description = 'The latest research, milestones and celebrations from DIALOG.';
const jsonLd = [
  breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'News', path: '/news/' }], Astro.site),
  collectionPageJsonLd('News', description, '/news/', Astro.site, posts.map((p) => ({
    name: p.data.title,
    path: p.data.standalone ? `/news/${p.id}/` : `/news/#${p.id}`,
  }))),
];
---

<Base title="News" description={description} jsonLd={jsonLd}>
  <PageHeader title="News" />
  <div class="container news-archive">
    {[...byYear.entries()].map(([year, items]) => (
      <section class="year" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class="year__label">{year}</h2>
        <div class="year__list">
          {items.map((post) => <NewsItem post={post} />)}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .news-archive { padding-bottom: var(--space-2xl); }
  .year + .year { margin-top: var(--space-xl); }
  .year__label {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    margin-bottom: var(--space-m);
    color: var(--ink-2);
    font-size: var(--step-0);
    font-variant-numeric: tabular-nums;
  }
  .year__label::after { content: ''; flex: 1; height: 1px; background: var(--line-strong); }
  .year__list { display: grid; gap: var(--space-l); }
</style>
