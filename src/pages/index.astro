---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NewsItem from '../components/NewsItem.astro';
import PublicationRow from '../components/PublicationRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../site.config';
import { href } from '../lib/url';
import { sortPublications } from '../lib/people';

const people = await getCollection('people');
const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const selected = sortPublications((await getCollection('publications')).filter((p) => p.data.selected)).slice(0, 5);
const projects = (await getCollection('projects'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 3);
---

<Base title={site.title} bareTitle description={site.tagline}>
  <section class="hero container">
    <figure class="hero__figure">
      <img
        class="hero__wordmark"
        src={href('/dialog-wordmark.svg')}
        width="596"
        height="256"
        alt="DIALOG — Interactive Intelligence"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <div class="hero__text">
      <p class="hero__tagline lede">{site.tagline}</p>
    </div>
  </section>

  <section class="section container about">
    <p class="eyebrow">About the group</p>
    <div class="about__text measure">
      {site.about.split('\n\n').map((paragraph) => <p set:html={paragraph} />)}
    </div>
    <p class="about__inst small muted">{site.institution.name}</p>
  </section>

  {
    /*
    news.length > 0 && (
      <section class="section container">
        <SectionHeading eyebrow="Latest" title="News" href={href('/news/')} linkLabel="All news" />
        <div>
          {news.map((post) => (
            <NewsItem post={post} compact />
          ))}
        </div>
      </section>
    )
    */
  }

  {
    /*
    selected.length > 0 && (
      <section class="section container">
        <SectionHeading eyebrow="Selected" title="Publications" href={href('/publications/')} linkLabel="All publications" />
        <div>
          {selected.map((pub) => (
            <PublicationRow pub={pub} people={people} />
          ))}
        </div>
      </section>
    )
    */
  }

  {
    /*
    projects.length > 0 && (
      <section class="section container">
        <SectionHeading eyebrow="Research" title="Projects" href={href('/projects/')} linkLabel="All projects" />
        <div class="grid grid--3">
          {projects.map((project) => (
            <ProjectCard project={project} people={people} />
          ))}
        </div>
      </section>
    )
    */
  }

</Base>

<style>
  .hero {
    padding-top: var(--space-l);
    display: grid;
    gap: var(--space-l);
  }
  .hero__figure {
    margin: 0;
    aspect-ratio: 21 / 9;
    border-radius: var(--radius-lg);
    background: #171716;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .hero__wordmark {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: clamp(1.5rem, 5vw, 4rem);
  }
  .hero__text {
    display: grid;
    gap: var(--space-s);
  }
  .hero__tagline {
    font-size: var(--step-1);
  }
  .about {
    display: grid;
    gap: var(--space-s);
  }
  .about__text {
    font-size: var(--step-1);
    line-height: 1.55;
    font-family: var(--font-display);
    font-weight: 400;
    font-variation-settings: 'opsz' 18, 'SOFT' 0;
    text-wrap: pretty;
  }
  .about__text p + p {
    margin-top: var(--space-m);
  }
  @media (max-width: 40em) {
    .hero__figure {
      aspect-ratio: 3 / 2;
    }
  }
</style>
