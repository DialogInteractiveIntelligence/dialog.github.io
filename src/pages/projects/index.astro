---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectTeaser from '../../components/ProjectTeaser.astro';
import { breadcrumbJsonLd, collectionPageJsonLd } from '../../lib/seo';
import reflectimateImage from '../../assets/projects/reflectimate/study2-emnlp.png';
import bubbleBoardImage from '../../assets/projects/bubble-board/bubble-board.png';

const projects = [
  { title: 'ReflectiMate', path: '/projects/reflectimate/', summary: 'A research project on collaborative reflection: helping people see the coverage of their own reasoning in decision-support dialogue.', image: reflectimateImage, imageAlt: 'Diagram of the ReflectiMate collaborative reflection study' },
  { title: 'Bubble board', path: '/projects/bubble-board/', summary: 'Interactive touch-table software designed to support collaborative group activities', image: bubbleBoardImage, imageAlt: 'Bubble Board illustration showing people collaborating around a shared touch-table' },
];
const description = 'Explore the dialogue and Hybrid Intelligence research projects at DIALOG.';
const jsonLd = [
  breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Projects', path: '/projects/' }], Astro.site),
  collectionPageJsonLd('Projects', description, '/projects/', Astro.site, projects.map((p) => ({ name: p.title, path: p.path }))),
];
---

<Base title="Projects" description={description} jsonLd={jsonLd}>
  <PageHeader title="Projects" />
  <div class="container project-list">
    {projects.map((project) => <ProjectTeaser {...project} />)}
  </div>
</Base>

<style>
  .project-list { display: grid; gap: var(--space-m); padding-bottom: var(--space-xl); }
</style>
